<style>
.trollian-card * { box-sizing: border-box; margin: 0; padding: 0; }
 
.trollian-card {
  --color-card:{{color-card}};
  --color-bg:  {{color-bg}};
  --color-txt: {{color-txt}};
  --space: 8px;

  width: 700px;
  background: linear-gradient(120deg,
    var(--color-card) 0%,
    var(--color-card) 45%,
    color-mix(in hsl, var(--color-card), white) 45%,
    var(--color-card) 100%
  );
  border-radius: 8px;
  padding:calc(1.5 * var(--space));
  margin:auto;
  font-family: courier new, courier, monospace;
}
.trl-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space);

  font-size: 22px;
  font-weight: bold;
}
.trl-header .race {
   color: white;
   text-transform: uppercase;
}
.trl-header .name {
   color: var(--color-txt);
}
.trl-inner {
  background: var(--color-bg);
  border: 4px solid var(--color-txt);
  padding: 10px;
  position: relative;
  min-height: 320px;
}
.sprite {
  position: absolute;
  bottom: 0;
  left:50%;transform: translateX(-50%);
  height: 100%;
  z-index: 1;
}
.trl-boxes {
  position:relative;z-index:2;
  display: grid;
  grid-template-columns: 130px 1fr 130px;
  gap: var(--space);
}
.trl-box-space {
  grid-column: 2;
  grid-row: 1 / span 2;
}
.trl-box {
  border:4px solid var(--color-txt);
  width:100%;height:100px;
  display:flex;align-items:center;justify-content:center;
  overflow: hidden;
  background: white;

  color:var(--color-txt);
  font-size:14px;
  font-weight:bold;
  line-height:1.5;
}
.trl-box img {
  width: auto;
  height: 100%;
  padding: 4px;
}
.trl-textbox {
  grid-column: 1 / span 3;
  display:block;
  padding: 8px 10px;
  min-height: 100px;height:fit-content;
  text-align:left;
  white-space: pre-wrap;
  word-break: break-word;
}
</style>

<div class="trollian-card">

<div class="trl-header">
  <span class="race">{{{race}}}</span>
  <span class="name">{{{name}}}</span>
</div>

<div class="trl-inner">
  <img class="sprite" src="{{{sprite}}}">
  <div class="trl-boxes">
    <div class="trl-box">extra 1</div>
    <div class="trl-box">extra 1</div>
    <div class="trl-box">extra 1</div>
    <div class="trl-box">extra 1</div>
    <div class="trl-box-space"></div>
    <div class="trl-box trl-textbox">{{textbox}}</div>
  </div>
</div>

</div>
